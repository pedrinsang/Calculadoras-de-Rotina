rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function usuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function geral() {
      return autenticado() && (
        usuario().role == 'admin' ||
        usuario().perfil == 'Administrador Geral'
      );
    }

    function secretaria() {
      return autenticado() && (
        geral() ||
        usuario().perfil == 'Secretaria'
      );
    }

    function laboratorio(lab) {
      return autenticado() && (
        geral() ||
        lab in usuario().laboratorios
      );
    }

    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || geral());
      allow create: if autenticado() && request.auth.uid == uid;
      allow update, delete: if geral();
    }

    match /entradasSecretaria/{id} {
      allow read: if secretaria();
      allow create, update, delete: if secretaria();
    }

    match /requisicoes/{id} {
      allow read: if secretaria() || laboratorio(resource.data.laboratorio);
      allow create: if secretaria();
      allow update: if laboratorio(resource.data.laboratorio);
      allow delete: if geral();
    }

    match /tarefas/{id} {
      allow read: if secretaria() || laboratorio(resource.data.laboratorio);
      allow create, update: if laboratorio(request.resource.data.laboratorio);
      allow delete: if geral();
    }

    match /historico/{id} {
      allow read: if secretaria() || laboratorio(resource.data.laboratorio);
      allow create, update: if laboratorio(request.resource.data.laboratorio);
      allow delete: if geral();
    }

    match /laudos/{id} {
      allow read: if secretaria() || laboratorio(resource.data.laboratorio);
      allow create, update: if laboratorio(request.resource.data.laboratorio);
      allow delete: if geral();
    }

    match /auditoria/{id} {
      allow read: if geral() || secretaria();
      allow create: if autenticado();
      allow update, delete: if geral();
    }

    match /configuracoes/{id} {
      allow read: if autenticado();
      allow write: if geral() || secretaria();
    }

    match /proprietarios/{id} {
      allow read, write: if secretaria();
    }
  }
}
