rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() {
      return request.auth != null;
    }

    function usuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function geral() {
      return usuario().role == 'admin' ||
        usuario().perfil == 'Administrador Geral';
    }

    function secretaria() {
      return geral() || usuario().perfil == 'Secretaria';
    }

    function laboratorio(lab) {
      return geral() || lab in usuario().laboratorios;
    }

    match /{laboratorio}/{arquivo=**} {
      allow read: if secretaria() || laboratorio(laboratorio);
      allow write: if laboratorio(laboratorio) || secretaria();
    }

    match /{allPaths=**} {
      allow read, write: if autenticado() && geral();
    }
  }
}
